set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY mc6809_fmax_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SEED 1
set_global_assignment -name VERILOG_FILE ../../cpu/mc6809/mc6809i.v
set_global_assignment -name VERILOG_FILE ../../cpu/mc6809/jtframe_sys6809.v
set_global_assignment -name VERILOG_FILE ../../jtframe/jtframe_z80wait.v
set_global_assignment -name VERILOG_FILE ../../jtframe/jtframe_ff.v
set_global_assignment -name VERILOG_FILE ../../jtframe/jtframe_dual_ram.v
set_global_assignment -name VERILOG_FILE ../../jtframe/sdram/jtframe_sdram64.v
set_global_assignment -name VERILOG_FILE ../../jtframe/sdram/jtframe_sdram64_bank.v
set_global_assignment -name VERILOG_FILE ../../jtframe/sdram/jtframe_sdram64_init.v
set_global_assignment -name VERILOG_FILE ../../jtframe/sdram/jtframe_sdram64_latch.v
set_global_assignment -name VERILOG_FILE ../../jtframe/sdram/jtframe_sdram64_rfsh.v
set_global_assignment -name SYSTEMVERILOG_FILE mc6809_fmax_top.sv
set_global_assignment -name SDC_FILE mc6809_fmax.sdc
# Virtual pins: the pad ring must not enter the measurement.
set_instance_assignment -name VIRTUAL_PIN ON -to io_din[*]
set_instance_assignment -name VIRTUAL_PIN ON -to nirq
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to sig[*]
set_instance_assignment -name VIRTUAL_PIN ON -to sdram_*

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"